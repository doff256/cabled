<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cabled.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cabled">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status: what's happening and what to do next (windows-app.md) -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="12" Height="12" VerticalAlignment="Center" Fill="Gray" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Headline" Style="{StaticResource SubtitleTextBlockStyle}" Text="Starting" />
                <TextBlock x:Name="Detail" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="DeviceText" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Preview: exactly what the virtual camera sends -->
        <Border Grid.Row="1" CornerRadius="8" Background="#FF101114">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform" />
                <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="#99FFFFFF"
                           Text="No video yet" />
            </Grid>
        </Border>

        <!-- Lens + zoom (R6) -->
        <Grid x:Name="CameraControls" Grid.Row="2" ColumnSpacing="16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LensPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
            <Grid x:Name="ZoomRow" Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PresetPanel" Orientation="Horizontal" Spacing="4" />
                <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0" Maximum="1000" StepFrequency="1"
                        IsThumbToolTipEnabled="False" VerticalAlignment="Center" MinWidth="160" />
                <TextBlock x:Name="ZoomText" Grid.Column="2" MinWidth="48" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" Text="1.0×" />
            </Grid>
            <TextBlock x:Name="LensText" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Stats + virtual camera state -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatsText" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="VcamText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
