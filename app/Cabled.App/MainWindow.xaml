<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cabled.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cabled">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Status: what's happening and what to do next (windows-app.md) -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="12" Height="12" VerticalAlignment="Center" Fill="Gray" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Headline" Style="{StaticResource SubtitleTextBlockStyle}" Text="Starting" />
                <TextBlock x:Name="Detail" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="DeviceText" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Preview: exactly what the virtual camera sends. Click to focus there. -->
        <Border Grid.Row="1" CornerRadius="8" Background="#FF101114">
            <Grid x:Name="PreviewHost" Background="Transparent">
                <Image x:Name="Preview" Stretch="Uniform" />
                <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="#99FFFFFF"
                           Text="No video yet" IsHitTestVisible="False" />
                <!-- Where the last click focused (fades out) -->
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="FocusMark" Width="56" Height="56" Stroke="#FFFFD60A" StrokeThickness="1.5"
                               Opacity="0" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Side panel (R8, pages in R9): the settings sit next to the preview so every change is
             seen as it's made. -->
        <Grid x:Name="SidePanel" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="PageBar">
                <SelectorBarItem Text="Framing" Tag="FramingPage" IsSelected="True" />
                <SelectorBarItem Text="Camera" Tag="CameraPage" />
                <SelectorBarItem Text="Image" Tag="ImagePage" />
                <SelectorBarItem Text="Presets" Tag="PresetsPage" />
                <SelectorBarItem Text="App" Tag="AppPage" />
            </SelectorBar>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="0,0,12,0">

                <!-- Framing -->
                <StackPanel x:Name="FramingPage" Spacing="8">
                    <Grid>
                        <TextBlock Text="Framing" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="FramingSwitch" HorizontalAlignment="Right" OnContent="" OffContent=""
                                      IsOn="True" MinWidth="0" />
                    </Grid>
                    <!-- Box in a box: the whole camera view, with what's being sent outlined -->
                    <Border CornerRadius="6" Background="#FF101114">
                        <Grid x:Name="OverviewHost" Background="Transparent" Height="160">
                            <Image x:Name="OverviewImage" Stretch="Uniform" />
                            <Canvas x:Name="OverviewCanvas">
                                <Rectangle x:Name="CropBox" Stroke="#FF5A78C8" StrokeThickness="2" RadiusX="3" RadiusY="3"
                                           Fill="#225A78C8" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <Grid>
                        <TextBlock Text="Drag the box to adjust the shot" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="NudgeResetButton" Content="Reset" HorizontalAlignment="Right"
                                         Padding="4,0" FontSize="12" Visibility="Collapsed" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Wide ↔ close" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="FramingZoomText" HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextBlockStyle}" Text="2.0×" />
                    </Grid>
                    <Slider x:Name="TightnessSlider" Minimum="0" Maximum="100" Value="50" IsThumbToolTipEnabled="False" />
                    <TextBlock x:Name="FramingLimitText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SpeedCombo" HorizontalAlignment="Stretch" SelectedIndex="1">
                            <x:String>Calm</x:String>
                            <x:String>Normal</x:String>
                            <x:String>Fast</x:String>
                        </ComboBox>
                        <CheckBox x:Name="GroupCheck" Grid.Column="1" Content="Everyone" MinWidth="0" />
                    </Grid>
                </StackPanel>

                <!-- Camera: focus, exposure, white balance, quality -->
                <StackPanel x:Name="CameraPage" Spacing="8" Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="Focus" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="FocusAutoSwitch" HorizontalAlignment="Right" OnContent="Auto"
                                      OffContent="Manual" IsOn="True" MinWidth="0" />
                    </Grid>
                    <Slider x:Name="FocusSlider" Minimum="0" Maximum="100" IsEnabled="False" IsThumbToolTipEnabled="False" />

                    <Grid>
                        <TextBlock Text="Exposure" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="ExposureAutoSwitch" HorizontalAlignment="Right" OnContent="Auto"
                                      OffContent="Manual" IsOn="True" MinWidth="0" />
                    </Grid>
                    <StackPanel x:Name="ExposureAutoPanel" Spacing="2">
                        <TextBlock x:Name="BiasText" Style="{StaticResource CaptionTextBlockStyle}" Text="Brightness 0.0 EV" />
                        <Slider x:Name="BiasSlider" Minimum="-30" Maximum="30" Value="0" IsThumbToolTipEnabled="False" />
                    </StackPanel>
                    <StackPanel x:Name="ExposureManualPanel" Spacing="2" Visibility="Collapsed">
                        <TextBlock x:Name="IsoText" Style="{StaticResource CaptionTextBlockStyle}" Text="ISO" />
                        <Slider x:Name="IsoSlider" Minimum="0" Maximum="1000" IsThumbToolTipEnabled="False" />
                        <TextBlock x:Name="ShutterText" Style="{StaticResource CaptionTextBlockStyle}" Text="Shutter" />
                        <Slider x:Name="ShutterSlider" Minimum="0" Maximum="1000" IsThumbToolTipEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="ExposureLive" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid>
                        <TextBlock Text="White balance" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="WbAutoSwitch" HorizontalAlignment="Right" OnContent="Auto"
                                      OffContent="Manual" IsOn="True" MinWidth="0" />
                    </Grid>
                    <StackPanel x:Name="WbManualPanel" Spacing="2" Visibility="Collapsed">
                        <TextBlock x:Name="TempText" Style="{StaticResource CaptionTextBlockStyle}" Text="5000 K" />
                        <Slider x:Name="TempSlider" Minimum="2500" Maximum="9000" Value="5000" StepFrequency="50"
                                IsThumbToolTipEnabled="False" />
                        <TextBlock x:Name="TintText" Style="{StaticResource CaptionTextBlockStyle}" Text="Tint 0" />
                        <Slider x:Name="TintSlider" Minimum="-50" Maximum="50" Value="0" IsThumbToolTipEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="Tip: click the preview to focus and expose there."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Quality: pin the capture (R-58) -->
                    <TextBlock Text="Quality" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CaptureCombo" Header="Capture" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <x:String>Auto</x:String>
                            <x:String>720p</x:String>
                            <x:String>1080p</x:String>
                            <x:String>4K</x:String>
                        </ComboBox>
                        <ComboBox x:Name="FpsCombo" Grid.Column="1" Header="Frame rate" HorizontalAlignment="Stretch"
                                  SelectedIndex="0">
                            <x:String>Auto</x:String>
                            <x:String>30</x:String>
                            <x:String>60</x:String>
                            <x:String>120</x:String>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="Auto follows the app using the camera. A hot phone steps down by itself."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Image: adjustments done on the PC, seen by every app (R9) -->
                <StackPanel x:Name="ImagePage" Spacing="4" Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="Brightness" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="BrightnessText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Text="0" />
                    </Grid>
                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0" IsThumbToolTipEnabled="False" />
                    <Grid>
                        <TextBlock Text="Contrast" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="ContrastText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Text="0" />
                    </Grid>
                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" IsThumbToolTipEnabled="False" />
                    <Grid>
                        <TextBlock Text="Saturation" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="SaturationText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Text="0" />
                    </Grid>
                    <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="0" IsThumbToolTipEnabled="False" />
                    <Grid>
                        <TextBlock Text="Sharpness" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="SharpnessText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Text="0" />
                    </Grid>
                    <Slider x:Name="SharpnessSlider" Minimum="0" Maximum="100" Value="0" IsThumbToolTipEnabled="False" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Mirror" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="MirrorSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                    <ComboBox x:Name="RotationCombo" Header="Rotation" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <x:String>Auto (follows the phone)</x:String>
                        <x:String>Landscape</x:String>
                        <x:String>Portrait</x:String>
                        <x:String>Landscape, upside down</x:String>
                        <x:String>Portrait, upside down</x:String>
                    </ComboBox>
                    <Button x:Name="NeutralButton" Content="Reset to neutral" Margin="0,12,0,0" />
                    <TextBlock Text="Mirror flips what every app receives. Most call apps already mirror your own view, so leave it off unless text looks backwards to others."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Presets: framing + camera + image together, per iPhone (R9) -->
                <StackPanel x:Name="PresetsPage" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="A preset keeps framing, camera and image settings together. Presets belong to this iPhone."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PresetNameBox" PlaceholderText="Name, e.g. Desk, Evening" MaxLength="40" />
                        <Button x:Name="SavePresetButton" Grid.Column="1" Content="Save" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <ListView x:Name="PresetList" SelectionMode="Single" MinHeight="60" />
                    <TextBlock x:Name="PresetEmptyText" Text="No presets yet." Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ApplyPresetButton" Content="Apply" IsEnabled="False" />
                        <Button x:Name="RenamePresetButton" Content="Rename" IsEnabled="False" />
                        <Button x:Name="DeletePresetButton" Content="Delete" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="Rename uses the name typed above. Double-click a preset to apply it."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- App: login, tray, about -->
                <StackPanel x:Name="AppPage" Spacing="8" Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="Start at login, in the tray" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="AutostartSwitch" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Keep running in the tray when closed" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,64,0" />
                        <ToggleSwitch x:Name="TraySwitch" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0"
                                      IsOn="True" />
                    </Grid>
                    <TextBlock Text="With both on, plugging in your iPhone is enough: apps find Cabled Camera without opening anything."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Cabled is MIT-licensed. Video decoding uses FFmpeg (LGPL 2.1), shipped as separate DLLs you can replace. Cabled never checks for updates or sends anything over the network by itself." />
                    <HyperlinkButton x:Name="ReleasesLink" Content="Check for updates (opens the releases page)" Padding="0" />
                    <HyperlinkButton x:Name="SettingsFolderLink" Content="Open the settings folder" Padding="0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </Grid>

        <!-- Lens + zoom (R6) -->
        <Grid x:Name="CameraControls" Grid.Row="2" ColumnSpacing="16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LensPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
            <Grid x:Name="ZoomRow" Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PresetPanel" Orientation="Horizontal" Spacing="4" />
                <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0" Maximum="1000" StepFrequency="1"
                        IsThumbToolTipEnabled="False" VerticalAlignment="Center" MinWidth="160" />
                <TextBlock x:Name="ZoomText" Grid.Column="2" MinWidth="48" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" Text="1.0×" />
            </Grid>
            <TextBlock x:Name="LensText" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Stats + virtual camera state -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatsText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="VcamText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
