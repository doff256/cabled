<?xml version="1.0" encoding="utf-8"?>
<!--
  Mangrove Glass for WinUI 3. Source of truth: https://github.com/doff256/mangrove-glass
  (DESIGN.md, bundle.css, components/*.html). Every template here is a port of a bundle.css class:
  mg-btn (primary, glass, ghost, danger), mg-toggle, the components/Slider.html groove, mg-pill,
  mg-solid, mg-glass, mg-well, mg-sigil.
  GENERATED OUTPUT: edit this file or make-theme.ps1, then run make-theme.ps1 to write Mangrove.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
<!--THEMES-->
    </ResourceDictionary.ThemeDictionaries>

    <!-- Fonts (OFL, shipped in Assets/Fonts). Fallbacks per DESIGN.md. -->
    <FontFamily x:Key="FontDisplay">ms-appx:///Assets/Fonts/BricolageGrotesque.ttf#Bricolage Grotesque, Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="FontText">ms-appx:///Assets/Fonts/Geist.ttf#Geist, Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="FontMono">ms-appx:///Assets/Fonts/GeistMono.ttf#Geist Mono, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist.ttf#Geist, Segoe UI Variable Text</FontFamily>

    <!-- Radii: radius-sm 8 / md 12 / lg 18 / pill -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">18</CornerRadius>

    <!-- Focus: 2px focus (mangrove-glow), offset 2px -->
    <Thickness x:Key="FocusVisualPrimaryThickness">2</Thickness>
    <Thickness x:Key="FocusVisualSecondaryThickness">0</Thickness>

    <!-- ================= Type (DESIGN.md "Type") ================= -->
    <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HelpTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" />
    </Style>
    <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MutedLabelTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" />
    </Style>
    <!-- eyebrow: write the text in capitals (XAML has no text-transform) -->
    <Style x:Key="EyebrowTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="LineHeight" Value="42" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="NumTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>
    <Style x:Key="UnitTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" />
    </Style>
    <Style x:Key="ReadoutTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>
    <Style x:Key="ReadoutXlTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource ReadoutTextBlockStyle}">
        <Setter Property="FontSize" Value="56" />
        <Setter Property="LineHeight" Value="56" />
        <Setter Property="CharacterSpacing" Value="-40" />
    </Style>

    <!-- ================= Materials ================= -->
    <!-- mg-solid: holds data -->
    <Style x:Key="SolidPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Surface200Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- Card in the side column (Window.html: mg-solid, padding 14) -->
    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource SolidPanelStyle}">
        <Setter Property="Padding" Value="14" />
    </Style>
    <!-- mg-glass: floats over content. Add a GlassSheen border inside for the top reflection. -->
    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassAcrylicBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <!-- Carved area (preview, box-in-box): surface-000 -->
    <Style x:Key="WellStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Surface000Brush}" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style x:Key="HairlineStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource LineBrush}" />
    </Style>
    <!-- mg-pill: dot + word, both in the status colour (set Foreground on the pill's TextBlock and dot) -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{ThemeResource Surface300Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PillTextStyle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ================= mg-btn ================= -->
    <!-- Secondary: raised surface-300, line border, shadow-raise; hover brightens; press sinks 1px into a well. -->
    <ControlTemplate x:Key="MgButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><CompositeTransform x:Name="Press" /></Grid.RenderTransform>
            <Border x:Name="Drop" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource RaiseShadowBrush}" Margin="0,2,0,-2" />
            <Border x:Name="Face" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="Edge" CornerRadius="{TemplateBinding CornerRadius}" Margin="1" BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource RaiseEdgeBrush}" />
            <Border x:Name="Sink" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource WellShadeBrush}" Opacity="0" />
            <Border x:Name="Lit" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource InkBrush}" Opacity="0" />
            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.12" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0" /></Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="TranslateY" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Sink" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Drop" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- Primary: polished mangrove wood under a glass lacquer (highlight on the top half). One per view. -->
    <ControlTemplate x:Key="MgPrimaryButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><CompositeTransform x:Name="Press" /></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="48*" /><RowDefinition Height="52*" /></Grid.RowDefinitions>
            <Border x:Name="Drop" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource RaiseShadowBrush}" Margin="0,2,0,-2" />
            <Border Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource MangroveLacquerBrush}"
                    BorderBrush="{ThemeResource MangroveDeepBrush}" BorderThickness="1" />
            <Border x:Name="Shine" Margin="1,1,1,0" CornerRadius="11,11,6,6" Background="{ThemeResource LacquerShineBrush}" />
            <Border x:Name="Sink" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource WellShadeBrush}" Opacity="0" />
            <Border x:Name="Lit" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource OnMangroveBrush}" Opacity="0" />
            <ContentPresenter x:Name="ContentPresenter" Grid.RowSpan="2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{ThemeResource OnMangroveBrush}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.12" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0" /></Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="TranslateY" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Sink" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Drop" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- Ghost: toolbars and dismissals; ink-muted until hovered, then surface-300. -->
    <ControlTemplate x:Key="MgGhostButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Face" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource Surface300Brush}" Opacity="0" />
            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{ThemeResource InkMutedBrush}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              AutomationProperties.AccessibilityView="Raw" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.12" />
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                        <VisualState.Setters><Setter Target="ContentPresenter.Foreground" Value="{ThemeResource InkBrush}" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0" /></Storyboard>
                        <VisualState.Setters><Setter Target="ContentPresenter.Foreground" Value="{ThemeResource InkBrush}" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <!-- Every Button is an mg-btn: height 40, padding 0 16, radius-md, label 500 13px. -->
    <Style TargetType="Button">
        <Setter Property="Template" Value="{StaticResource MgButtonTemplate}" />
        <Setter Property="Background" Value="{ThemeResource Surface300Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Template" Value="{StaticResource MgButtonTemplate}" />
        <Setter Property="Background" Value="{ThemeResource Surface300Brush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FocusVisualMargin" Value="-3" />
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Template" Value="{StaticResource MgPrimaryButtonTemplate}" />
    </Style>
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Template" Value="{StaticResource MgGhostButtonTemplate}" />
    </Style>
    <!-- Danger: secondary with rose text and a word that says what is destroyed. Never a red fill. -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource RoseBrush}" />
    </Style>
    <!-- Glass (mg-btn glass variant, 30px high): over the camera preview. -->
    <Style x:Key="GlassButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Lens picker (Window.html): glass mg-btn at 30px; the selected lens is the primary (lacquered) one. -->
    <Style x:Key="LensToggleStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><CompositeTransform x:Name="Press" /></Grid.RenderTransform>
                        <Grid.RowDefinitions><RowDefinition Height="48*" /><RowDefinition Height="52*" /></Grid.RowDefinitions>
                        <Border x:Name="Drop" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource RaiseShadowBrush}" Margin="0,2,0,-2" />
                        <Border x:Name="Glass" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource GlassBrush}"
                                BorderBrush="{ThemeResource GlassEdgeBrush}" BorderThickness="1" />
                        <Border x:Name="Lacquer" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource MangroveLacquerBrush}"
                                BorderBrush="{ThemeResource MangroveDeepBrush}" BorderThickness="1" Opacity="0" />
                        <Border x:Name="Shine" Margin="1,1,1,0" CornerRadius="11,11,5,5" Background="{ThemeResource LacquerShineBrush}" Opacity="0" />
                        <Border x:Name="Edge" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Margin="1" BorderThickness="0,1,0,0"
                                BorderBrush="{ThemeResource RaiseEdgeBrush}" />
                        <Border x:Name="Sink" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource WellShadeBrush}" Opacity="0" />
                        <Border x:Name="Lit" Grid.RowSpan="2" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource InkBrush}" Opacity="0" />
                        <ContentPresenter x:Name="ContentPresenter" Grid.RowSpan="2" Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}" Foreground="{ThemeResource InkBrush}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                          AutomationProperties.AccessibilityView="Raw" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="TranslateY" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Sink" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Drop" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lacquer" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                    </Storyboard>
                                    <VisualState.Setters><Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnMangroveBrush}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lacquer" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="0.06" Duration="0" />
                                    </Storyboard>
                                    <VisualState.Setters><Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnMangroveBrush}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lacquer" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="TranslateY" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Drop" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                    </Storyboard>
                                    <VisualState.Setters><Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnMangroveBrush}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lacquer" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= mg-toggle ================= -->
    <!-- Carved 44x26 track (surface-000 + shadow-well), raised 20px knob; on = mangrove-deep -> mangrove groove.
         The label sits to the RIGHT and is the Header ("Auto-framing", not "Enable auto-framing"). -->
    <Style TargetType="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid x:Name="Root" Background="Transparent" ColumnSpacing="12" MinHeight="30">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid x:Name="SwitchKnobBounds" Width="44" Height="26" VerticalAlignment="Center">
                            <Border CornerRadius="13" Background="{ThemeResource Surface000Brush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource WellLipBrush}" />
                            <Border x:Name="OnFill" CornerRadius="13" Background="{ThemeResource MangroveTrackBrush}" Opacity="0" />
                            <Border CornerRadius="13" Background="{ThemeResource WellShadeBrush}" />
                            <Grid x:Name="SwitchKnob" Width="20" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Grid.RenderTransform><TranslateTransform x:Name="KnobTranslateTransform" /></Grid.RenderTransform>
                                <Grid x:Name="Knob" RenderTransformOrigin="0,0.5">
                                <Grid.RenderTransform><ScaleTransform x:Name="KnobT" /></Grid.RenderTransform>
                                <Ellipse Fill="{ThemeResource RaiseShadowBrush}" Margin="0,2,0,-2" />
                                <Ellipse Fill="{ThemeResource KnobBrush}" />
                                <Ellipse x:Name="KnobOn" Fill="{ThemeResource KnobOnBrush}" Opacity="0" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <ContentPresenter x:Name="HeaderContentPresenter" Grid.Column="1" VerticalAlignment="Center"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Foreground="{ThemeResource InkBrush}" FontFamily="{StaticResource FontText}" FontSize="13"
                                          FontWeight="Medium" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                        <!-- ToggleSwitch toggles on a tap of this thumb and follows it while dragged; it covers the label too -->
                        <Thumb x:Name="SwitchThumb" Grid.ColumnSpan="2" AutomationProperties.AccessibilityView="Raw" IsTabStop="False">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <!-- the knob stretches while held -->
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- lands with a spring (ease-spring over dur-move) -->
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.26">
                                        <VisualTransition.GeneratedEasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.35" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="18" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="OnFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent" />
                                <VisualState x:Name="OnContent" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Slider (components/Slider.html) ================= -->
    <!-- Groove 10px surface-000 + shadow-well; fill inset 2px, mangrove-deep -> mangrove; 22px raised thumb
         that grows 18% while dragged. The label and mono value sit above, outside the control. -->
    <Style x:Key="MgSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform><ScaleTransform x:Name="Grow" /></Grid.RenderTransform>
                        <Ellipse Fill="{ThemeResource RaiseShadowBrush}" Margin="0,2,0,-2" />
                        <Ellipse Fill="{ThemeResource ThumbBrush}" />
                        <Ellipse Margin="1" Stroke="{ThemeResource RaiseEdgeBrush}" StrokeThickness="1" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12">
                                        <VisualTransition.GeneratedEasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" Visibility="Collapsed" />
                        <Grid x:Name="SliderContainer" Grid.Row="1" Background="Transparent" Control.IsTemplateFocusTarget="True">
                            <Grid x:Name="HorizontalTemplate" MinHeight="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" Height="10" VerticalAlignment="Center" CornerRadius="5"
                                        Background="{ThemeResource Surface000Brush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource WellLipBrush}" />
                                <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="10" Fill="Transparent" />
                                <!-- fill runs to the thumb's centre (the thumb sits in column 1) -->
                                <Rectangle x:Name="HorizontalDecreaseRect" Height="10" Fill="Transparent" />
                                <Rectangle Grid.ColumnSpan="2" Height="6" Margin="2,0,11,0" VerticalAlignment="Center"
                                           RadiusX="3" RadiusY="3" Fill="{ThemeResource MangroveFillBrush}" IsHitTestVisible="False" />
                                <Rectangle x:Name="DragGlow" Grid.ColumnSpan="2" Height="6" Margin="2,0,11,0" VerticalAlignment="Center" RadiusX="3" RadiusY="3"
                                           Fill="{ThemeResource MangroveGlowBrush}" Opacity="0" IsHitTestVisible="False" />
                                <Border Grid.ColumnSpan="3" Height="10" VerticalAlignment="Center" CornerRadius="5" Background="{ThemeResource WellShadeBrush}"
                                        IsHitTestVisible="False" />
                                <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="22" Height="22" Style="{StaticResource MgSliderThumbStyle}"
                                       DataContext="{TemplateBinding Value}" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <Grid x:Name="VerticalTemplate" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="3" Width="10" Fill="{ThemeResource Surface000Brush}" />
                                <Rectangle x:Name="VerticalDecreaseRect" Grid.Row="2" Width="6" Fill="{ThemeResource MangroveFillBrush}" />
                                <Thumb x:Name="VerticalThumb" Grid.Row="1" Width="22" Height="22" Style="{StaticResource MgSliderThumbStyle}"
                                       DataContext="{TemplateBinding Value}" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.26" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <!-- the fill glows faintly while dragging -->
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="DragGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" /></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Inputs: surface-300 well, radius-sm, 36px ================= -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource MangroveGlowBrush}" />
    </Style>
    <Style TargetType="SelectorBarItem">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
</ResourceDictionary>
